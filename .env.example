# Host paths/ports (optional). Leave commented to keep the Raspberry Pi defaults shown.
# Media/torrents data root (plex, jellyfin, *arr, suwayomi, kavita, qbittorrent, qbit-diskguard)
#DATA_DIR=/mnt/media/data
# Syncthing sync folder
#SYNC_DIR=/mnt/drive/sync
# Docker data-root (`docker info` DockerRootDir), mounted into cAdvisor at the same path
#DOCKER_DATA_ROOT=/mnt/media/docker-data
# Disks shown in the Homepage resources widget (host side; container paths stay /mnt/media and /mnt/drive)
#DISK1_PATH=/mnt/media
#DISK2_PATH=/mnt/drive
# Host ports for Traefik and Portainer (change when the host already uses 80/443/9443, e.g. a NAS UI)
#TRAEFIK_HTTP_PORT=80
#TRAEFIK_HTTPS_PORT=443
#PORTAINER_PORT=9443
# Immich Postgres storage tuning: empty = SSD, set HDD if the database lives on spinning disks
#DB_STORAGE_TYPE=
